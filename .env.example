# Optional public endpoint overrides. Open-Meteo requires no API key.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
VITE_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1
VITE_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# Do not place private API keys in VITE_* variables; Vite exposes them to browsers.
# Backend settings belong in the process environment, never in VITE_* variables:
# CLIMATESHIELD_DATABASE_URL=sqlite:///./climateshield.db (when run from backend\)
# CLIMATESHIELD_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443
# CLIMATESHIELD_COOKIE_SECURE=true
